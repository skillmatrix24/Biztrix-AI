rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Platform Owner check - SkillMatrix Master Node
     */
    function isPlatformOwner() {
      return isSignedIn() && (
        request.auth.uid == 'sEM5J1HuMCW8RbBTbvnJ5EwaDYA2' ||
        request.auth.uid == 'jA4htunMjSVcMBpRuzfSx8yooHC2' ||
        request.auth.token.email == 'skillmatrix24@gmail.com' ||
        request.auth.token.email == 'gw7infra@gmail.com'
      );
    }

    /**
     * GLOBAL MASTER OVERRIDE
     * Provides ONLY the Platform Owner unrestricted access across all nodes.
     */
    match /{allPaths=**} {
      allow read, write: if isPlatformOwner();
    }

    // --- SYSTEM & AUDIT RULES ---

    match /system/logs/payments/{logId} {
      allow read, write: if isPlatformOwner();
    }

    match /system/counters/memberships/{businessId} {
      allow read: if isBusinessMember(businessId) || isPlatformOwner();
      allow write: if isPlatformOwner();
    }

    // Platform-wide public config (Branding, App Theme)
    match /system/config/branding/{docId} {
      allow read: if true;
      allow write: if isPlatformOwner();
    }

    match /system/config/{document=**} {
      allow read: if true;
      allow write: if isPlatformOwner();
    }

    match /system/{document=**} {
      allow read, write: if isPlatformOwner();
    }

    // --- BUSINESS & USER HELPERS ---

    function isBusinessMember(businessId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let bizPath = /databases/$(database)/documents/businesses/$(businessId);
      let memberPath = /databases/$(database)/documents/businesses/$(businessId)/users/$(request.auth.uid);

      return isSignedIn() && (
        (exists(userPath) && get(userPath).data.businessId == businessId) ||
        (exists(memberPath)) ||
        (exists(bizPath) && get(bizPath).data.ownerId == request.auth.uid)
      );
    }

    function isBusinessAdmin(businessId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let bizPath = /databases/$(database)/documents/businesses/$(businessId);
      let memberPath = /databases/$(database)/documents/businesses/$(businessId)/users/$(request.auth.uid);

      return isSignedIn() && (
        (exists(bizPath) && get(bizPath).data.ownerId == request.auth.uid) ||
        (exists(userPath) &&
         get(userPath).data.businessId == businessId &&
         (get(userPath).data.role.lower() in ['admin', 'manager', 'owner'])) ||
        (exists(memberPath) &&
         (get(memberPath).data.role.lower() in ['admin', 'manager', 'owner']))
      );
    }

    /**
     * Helper to verify if the requester is the customer in question
     */
    function isTargetCustomer(businessId, customerId) {
      let customerPath = /databases/$(database)/documents/businesses/$(businessId)/customers/$(customerId);
      return isSignedIn() && customerId != null && exists(customerPath) && (
        get(customerPath).data.phone == request.auth.token.phone_number ||
        get(customerPath).data.phone == request.auth.token.phone_number.replace('+91', '')
      );
    }

    // --- DATA INTEGRITY HELPERS ---

    function isStockValid() {
      // Prevents writing a document with negative stock
      return request.resource == null || !('stock' in request.resource.data) || request.resource.data.stock >= 0;
    }

    // --- COLLECTION GROUP: INVITES ---
    match /{path=**}/invites/{inviteEmail} {
      allow read: if isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == inviteEmail.lower() ||
          request.auth.token.email == inviteEmail
        )) ||
        isPlatformOwner()
      );
    }

    // --- USER RULES ---

    match /users/{userId} {
      allow get: if isPlatformOwner() || (
        isSignedIn() && (
          request.auth.uid == userId ||
          (resource.data.status == 'pending' &&
           request.auth.token.email != null &&
           (resource.data.email == request.auth.token.email ||
            resource.data.email == request.auth.token.email.lower())) ||
          (resource.data.businessId != null && isBusinessMember(resource.data.businessId))
        )
      );

      allow list: if isPlatformOwner() || (
        isSignedIn() && (
          (request.auth.token.email != null &&
           ('email' in resource.data) &&
           (resource.data.email == request.auth.token.email ||
            resource.data.email == request.auth.token.email.lower())) ||
          (resource.data.businessId != null && isBusinessMember(resource.data.businessId))
        )
      );

      allow create: if isPlatformOwner() || (
        isSignedIn() && (
          // 1. Business admin creating a pending staff invite
          (request.resource.data.businessId is string &&
           isBusinessAdmin(request.resource.data.businessId) &&
           request.resource.data.status == 'pending') ||
          // 2. Owner creating their own profile right after creating their business
          (request.auth.uid == userId &&
           request.resource.data.id == request.auth.uid &&
           request.resource.data.businessId is string &&
           exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)) &&
           get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid) ||
          // 3. Invited staff member claiming an invite issued by that business admin
          (request.auth.uid == userId &&
           request.resource.data.id == request.auth.uid &&
           request.resource.data.businessId is string &&
           request.auth.token.email != null &&
           (exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)/invites/$(request.auth.token.email)) ||
            exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)/invites/$(request.auth.token.email.lower()))))
        )
      );

      allow update: if isPlatformOwner() || (
        isSignedIn() && (
          // Self update allowed only for non-privileged fields (cannot hijack businessId or escalate role)
          (request.auth.uid == userId &&
           request.resource.data.businessId == resource.data.businessId &&
           request.resource.data.role == resource.data.role) ||
          // Invited staff member claiming their invite during login/signup
          (request.auth.uid == userId &&
           request.resource.data.businessId is string &&
           request.auth.token.email != null &&
           (exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)/invites/$(request.auth.token.email)) ||
            exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)/invites/$(request.auth.token.email.lower())))) ||
          // Business admin updating a staff member in their own business
          (resource.data.businessId != null &&
           isBusinessAdmin(resource.data.businessId) &&
           request.resource.data.businessId == resource.data.businessId)
        )
      );

      allow delete: if isPlatformOwner() || (
        isSignedIn() && (
          request.auth.uid == userId ||
          (resource.data.status == 'pending' &&
           request.auth.token.email != null &&
           (resource.data.email == request.auth.token.email ||
            resource.data.email == request.auth.token.email.lower())) ||
          (resource.data.businessId != null && isBusinessAdmin(resource.data.businessId))
        )
      );
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid || isPlatformOwner()
      );
      allow create: if isSignedIn() && request.resource.data.recipientId is string;
    }

    // --- BUSINESS SCOPED RULES ---

    match /businesses/{businessId} {
      // Public reading allowed for published storefronts, slug lookup, and public portals
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isBusinessAdmin(businessId) || isPlatformOwner();
      allow delete: if isPlatformOwner();

      // STAFF INVITE MARKERS
      match /invites/{inviteEmail} {
        allow read: if isBusinessMember(businessId) ||
          (isSignedIn() && (
            request.auth.token.email == inviteEmail ||
            request.auth.token.email.lower() == inviteEmail.lower()
          )) ||
          isPlatformOwner();
        allow create, update: if isBusinessAdmin(businessId) || isPlatformOwner();
        allow delete: if isBusinessAdmin(businessId) ||
          (isSignedIn() && (
            request.auth.token.email == inviteEmail ||
            request.auth.token.email.lower() == inviteEmail.lower()
          )) ||
          isPlatformOwner();
      }

      // BUSINESS-SCOPED USER MIRRORS
      match /users/{memberUid} {
        allow read: if isBusinessMember(businessId) ||
          (isSignedIn() && request.auth.uid == memberUid) ||
          isPlatformOwner();
        allow create, update: if isBusinessAdmin(businessId) ||
          isPlatformOwner() ||
          (isSignedIn() && request.auth.uid == memberUid && (
            isBusinessMember(businessId) ||
            (request.auth.token.email != null && (
              exists(/databases/$(database)/documents/businesses/$(businessId)/invites/$(request.auth.token.email)) ||
              exists(/databases/$(database)/documents/businesses/$(businessId)/invites/$(request.auth.token.email.lower()))
            ))
          ));
        allow delete: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      // STOREFRONT CONFIG
      match /websites/{docId} {
        allow read: if true;
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      // CATALOG & INVENTORY
      match /products/{productId} {
        // Public can read only products intended for the storefront
        allow read: if resource.data.showOnWebsite == true || isBusinessMember(businessId) || isPlatformOwner();
        allow create, update: if (isBusinessMember(businessId) && isStockValid()) || isPlatformOwner();
        allow delete: if isBusinessMember(businessId) || isPlatformOwner();

        match /stockHistory/{historyId} {
          allow read, create: if isBusinessMember(businessId) || isPlatformOwner();
          allow update, delete: if isBusinessAdmin(businessId) || isPlatformOwner();
        }
      }

      // PRIVATE CONFIG (Credentials Node - Server Admin SDK only)
      match /privateConfig/{docId} {
        allow read, write: if false;
      }

      // SOLAR ASSETS
      match /solarPlants/{id} {
        allow read: if isBusinessMember(businessId) || isTargetCustomer(businessId, resource.data.customerId) || isPlatformOwner();
        allow write: if isBusinessMember(businessId) || isPlatformOwner();
      }

      // SOLAR PROCUREMENT
      match /solarPurchaseRequisitions/{id} {
        allow read: if isBusinessMember(businessId) || isPlatformOwner();
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      // SOLAR CUSTOMER PORTAL OVERRIDES
      match /solarInquiries/{id} {
        allow read: if isBusinessMember(businessId) || isTargetCustomer(businessId, resource.data.customerId) || isPlatformOwner();
        allow write: if isBusinessMember(businessId) || isPlatformOwner();
      }
      match /solarSurveys/{id} {
        allow read: if isBusinessMember(businessId) || isTargetCustomer(businessId, resource.data.customerId) || isPlatformOwner();
        allow write: if isBusinessMember(businessId) || isPlatformOwner();
      }
      match /solarSystemDesigns/{id} {
        allow read: if isBusinessMember(businessId) || isTargetCustomer(businessId, resource.data.customerId) || isPlatformOwner();
        allow write: if isBusinessMember(businessId) || isPlatformOwner();
      }
      match /solarInstallations/{id} {
        allow read: if isBusinessMember(businessId) || isTargetCustomer(businessId, resource.data.customerId) || isPlatformOwner();
        allow write: if isBusinessMember(businessId) || isPlatformOwner();
      }
      match /solarAmcContracts/{id} {
        allow read: if isBusinessMember(businessId) || isTargetCustomer(businessId, resource.data.customerId) || isPlatformOwner();
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }
      match /solarWarranties/{id} {
        allow read: if isBusinessMember(businessId) || isTargetCustomer(businessId, resource.data.customerId) || isPlatformOwner();
        allow write: if isBusinessMember(businessId) || isPlatformOwner();
      }
      match /solarServiceRequests/{id} {
        allow read: if isBusinessMember(businessId) || isTargetCustomer(businessId, resource.data.customerId) || isPlatformOwner();
        allow create: if isTargetCustomer(businessId, request.resource.data.customerId) || isBusinessMember(businessId) || isPlatformOwner();
        allow update: if isBusinessMember(businessId) || isPlatformOwner();
      }
      match /solarDocuments/{id} {
        allow read: if isBusinessMember(businessId) || (isTargetCustomer(businessId, resource.data.customerId) && resource.data.visibility == 'CUSTOMER_VISIBLE') || isPlatformOwner();
        allow write: if isBusinessMember(businessId) || isPlatformOwner();
      }
      match /solarDealerCommissions/{id} {
        allow read: if isBusinessMember(businessId) || isPlatformOwner();
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      // SOCIAL REVIEWS & FEEDBACK
      match /socialReviews/{id} {
        allow read, create: if true;
        allow update, delete: if isBusinessMember(businessId) || isPlatformOwner();
      }
      match /feedbackConfig/{configId} {
        allow read: if true;
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }
      match /feedback/{feedbackId} {
        allow get, create: if true;
        allow list: if isBusinessMember(businessId) || isPlatformOwner();
        allow update: if isBusinessMember(businessId) ||
          isPlatformOwner() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies', 'updatedAt']);
        allow delete: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /quotations/{id} {
        allow read: if isBusinessMember(businessId) || isTargetCustomer(businessId, resource.data.customerId) || isPlatformOwner();
        allow write: if isBusinessMember(businessId) || isPlatformOwner();
      }

      // LOYALTY CONFIG & TIERS
      match /loyaltyTiers/{tierId} {
        allow read, list: if true;
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      match /loyaltyJoinConfig/{configId} {
        allow read: if true;
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      match /loyaltyConfig/{configId} {
        allow read: if true;
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      match /loyaltyActivity/{activityId} {
        allow read: if isBusinessMember(businessId) ||
          isTargetCustomer(businessId, resource.data.customerId) ||
          isPlatformOwner();
        allow create: if isBusinessMember(businessId) ||
          isTargetCustomer(businessId, request.resource.data.customerId) ||
          isPlatformOwner();
        allow update, delete: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /loyaltyActivityLogs/{logId} {
        allow read, write: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /loyaltyAutomation/{ruleId} {
        allow read: if isBusinessMember(businessId) || isPlatformOwner();
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      match /references/{refId} {
        allow read: if isBusinessMember(businessId) || isPlatformOwner();
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      // GROWTH ENGINE & WHATSAPP AUTOMATION
      match /campaigns/{campaignId} {
        allow read, write: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /chats/{chatId} {
        allow read, write: if isBusinessMember(businessId) || isPlatformOwner();

        match /messages/{messageId} {
          allow read, write: if isBusinessMember(businessId) || isPlatformOwner();
        }
      }

      match /globalContacts/{contactId} {
        allow read, write: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /contactGroups/{groupId} {
        allow read, write: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /whatsappFollowups/{stepId} {
        allow read, write: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /whatsappTriggers/{triggerId} {
        allow read, write: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /whatsappKeywords/{keywordId} {
        allow read, write: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /coupons/{couponId} {
        allow read, list: if true;
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      match /paymentGatewayConfigs/{configId} {
        allow read: if true;
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      // ORDERS & PAYMENTS
      match /orders/{orderId} {
        allow get: if isBusinessMember(businessId) ||
          isTargetCustomer(businessId, resource.data.customerId) ||
          isPlatformOwner();
        allow list, write: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /payments/{paymentId} {
        allow read, write: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /notifications/{notifId} {
        allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isBusinessMember(businessId) || isPlatformOwner());
        allow create: if true;
        allow update: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isBusinessMember(businessId) || isPlatformOwner());
        allow delete: if isBusinessMember(businessId) || isPlatformOwner();
      }

      // MEMBERSHIPS & CUSTOMERS
      match /memberships/{memberId} {
        allow read: if true;
        allow create, delete: if isBusinessMember(businessId) || isPlatformOwner();
        allow update: if isBusinessMember(businessId) ||
          isTargetCustomer(businessId, resource.data.customerId) ||
          isPlatformOwner();
      }

      match /customers/{customerId} {
        allow read: if isBusinessMember(businessId) ||
          isTargetCustomer(businessId, customerId) ||
          isPlatformOwner();
        allow create, delete: if isBusinessMember(businessId) || isPlatformOwner();
        allow update: if isBusinessMember(businessId) ||
          (isTargetCustomer(businessId, customerId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['events', 'email', 'dob', 'anniversary', 'gender', 'city', 'address', 'profileBonusClaimed', 'updatedAt'])) ||
          isPlatformOwner();
      }

      // SUPPORT TICKETS
      match /complaints/{ticketId} {
        allow get, create: if true;
        allow list: if isBusinessMember(businessId) || isPlatformOwner();
        allow update: if isBusinessMember(businessId) ||
          isPlatformOwner() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'feedback', 'feedbackAt']);
        allow delete: if isBusinessMember(businessId) || isPlatformOwner();

        match /timeline/{logId} {
          allow read, create: if true;
          allow update, delete: if isBusinessMember(businessId) || isPlatformOwner();
        }
      }

      // TEAM ATTENDANCE, STAFF PAYMENTS & PUBLIC TRACKING MIRROR (NO PII)
      match /attendance/{recordId} {
        allow read: if isBusinessMember(businessId) || isPlatformOwner();
        allow create, update: if (
          (isBusinessAdmin(businessId) || isPlatformOwner()) &&
          request.resource.data.businessId == businessId &&
          request.resource.data.staffId is string &&
          request.resource.data.date is string
        );
        allow delete: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      match /staffPayments/{paymentId} {
        allow read: if isBusinessMember(businessId) || isPlatformOwner();
        allow create, update: if (
          (isBusinessAdmin(businessId) || isPlatformOwner()) &&
          request.resource.data.businessId == businessId &&
          request.resource.data.staffId is string &&
          request.resource.data.amount is number &&
          request.resource.data.amount >= 0
        );
        allow delete: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      match /paymentRequests/{requestId} {
        allow read: if isBusinessMember(businessId) || isPlatformOwner();
        allow create: if (
          (isBusinessMember(businessId) && request.resource.data.requesterId == request.auth.uid) ||
          isPlatformOwner()
        );
        allow update, delete: if isBusinessAdmin(businessId) || isPlatformOwner();
      }

      match /publicStaff/{staffId} {
        allow get: if resource.data.sharePublic == true || isBusinessMember(businessId) || isPlatformOwner();
        allow list: if isBusinessMember(businessId) || isPlatformOwner();
        allow write: if isBusinessAdmin(businessId) || isPlatformOwner();

        match /records/{recordId} {
          allow get, list: if (
            get(/databases/$(database)/documents/businesses/$(businessId)/publicStaff/$(staffId)).data.sharePublic == true ||
            isBusinessMember(businessId) ||
            isPlatformOwner()
          );
          allow write: if isBusinessAdmin(businessId) || isPlatformOwner();
        }
      }

      // REAL ESTATE ASSET CATALOG & BUYER LEADS
      match /properties/{propertyId} {
        allow read: if isBusinessMember(businessId) || isPlatformOwner() || resource.data.isPublic == true;
        allow create, update: if isBusinessMember(businessId) || isPlatformOwner();
        allow delete: if isBusinessMember(businessId) || isPlatformOwner();
      }

      match /realEstateLeads/{leadId} {
        allow read: if isBusinessMember(businessId) || isPlatformOwner();
        allow create: if isBusinessMember(businessId) || isPlatformOwner() || (request.resource.data.businessId == businessId && request.resource.data.name is string);
        allow update, delete: if isBusinessMember(businessId) || isPlatformOwner();
      }

      // BACK OFFICE: PROJECTS & TASK MANAGEMENT
      match /projects/{projectId} {
        // Allow public read if the project is enabled for client tracking
        allow get: if resource.data.sharePublic == true || isBusinessMember(businessId) || isPlatformOwner();
        allow list: if isBusinessMember(businessId) || isPlatformOwner();
        allow create: if isBusinessMember(businessId) || isPlatformOwner();
        allow update: if isBusinessMember(businessId) || isPlatformOwner() ||
          // Allow client milestone approval on publicly shared projects
          (resource.data.sharePublic == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['milestones', 'lastClientUpdate']));
        allow delete: if isBusinessAdmin(businessId) || isPlatformOwner();

        match /clientMessages/{msgId} {
          allow read, create: if true;
          allow update, delete: if isBusinessMember(businessId) || isPlatformOwner();
        }
      }

      match /tasks/{taskId} {
        allow read: if isBusinessMember(businessId) || isPlatformOwner() ||
          (resource.data.projectId != null &&
           exists(/databases/$(database)/documents/businesses/$(businessId)/projects/$(resource.data.projectId)) &&
           get(/databases/$(database)/documents/businesses/$(businessId)/projects/$(resource.data.projectId)).data.sharePublic == true);
        allow create, update: if isBusinessMember(businessId) || isPlatformOwner();
        allow delete: if isBusinessMember(businessId) || isPlatformOwner();
      }

      // BUSINESS DEFAULT CATCH-ALL
      match /{allPaths=**} {
        allow read: if isBusinessMember(businessId) || isPlatformOwner();
        allow write: if (isBusinessMember(businessId) && isStockValid()) || isPlatformOwner();
      }
    }
  }
}
